{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Rocktier Compressor",
        "width": 960,
        "height": 720,
        "minWidth": 780,
        "minHeight": 540,
        "center": true,
        "decorations": true,
        "shadow": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["underWindowBackground"],
          "state": "followsWindowActiveState"
        }
      }
    ]
  },
  "bundle": {
    "resources": ["compress-engine-macos"]
  }
}
